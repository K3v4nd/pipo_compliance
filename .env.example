# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================================
# SUPABASE CONFIGURATION (Vite Client Environment Variables)
# ===================================================================
# Copia tu URL de proyecto de Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Copia tu Clave Anónima / Pública (Project Settings -> API -> Project API keys -> anon / public)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Nombre de la tabla (opcional, por defecto 'registros_cumplimiento')
VITE_SUPABASE_TABLE_NAME=registros_cumplimiento

# ===================================================================
# DATOS DE EMPRESA (Opcional - por defecto Hotel Pipo Internacional)
# ===================================================================
VITE_COMPANY_NAME="HOTEL PIPO INTERNACIONAL C.A."
VITE_COMPANY_COMMERCIAL_NAME="HOTEL PIPO INTERNACIONAL"
VITE_COMPANY_RIF="J-07513364-1"
VITE_COMPANY_ADDRESS="Av. Principal El Castaño / Maracay, Edo. Aragua"
VITE_COMPANY_PHONES="0243-2413111 / 0243-2411990"
VITE_COMPANY_EMAIL="cumplimiento@hotelpipo.com"
VITE_COMPANY_WEBSITE="WWW.HOTELPIPO.COM"
VITE_COMPANY_PRIMARY_COLOR="#0f3a6e"

